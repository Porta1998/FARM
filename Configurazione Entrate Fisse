<body class="bg-background text-on-background min-h-screen pb-40">
<!-- Top Navigation Anchor -->
<header class="fixed top-0 w-full z-50 bg-[#faf9f6]/70 dark:bg-[#1a1c18]/70 backdrop-blur-xl shadow-[0_40px_40px_rgba(0,0,0,0.04)] flex items-center justify-between px-6 py-4 w-full">
<div class="flex items-center gap-4">
<button class="text-[#456646] active:scale-95 transition-transform duration-200">
<span class="material-symbols-outlined" data-icon="arrow_back">arrow_back</span>
</button>
<h1 class="font-manrope text-lg font-semibold tracking-tight text-[#456646]">I tuoi flussi</h1>
</div>
<div class="flex items-center gap-2">
<div class="flex gap-1">
<div class="h-1.5 w-4 bg-primary-container rounded-full"></div>
<div class="h-1.5 w-8 bg-primary rounded-full"></div>
<div class="h-1.5 w-4 bg-primary-container rounded-full"></div>
</div>
<span class="font-label text-[10px] font-bold tracking-widest uppercase text-primary ml-2">Passo 2 di 3</span>
</div>
</header>
<main class="pt-28 px-6 max-w-2xl mx-auto">
<!-- Editorial Display Moment -->
<section class="mb-12">
<h2 class="text-[1.5rem] font-semibold text-on-surface leading-tight mb-2">Quali sono le tue entrate?</h2>
<p class="text-on-surface-variant body-md mb-8">Definisci le tue entrate ricorrenti per visualizzare la tua capacità di risparmio.</p>
<!-- Hero Balance Card -->
<div class="relative overflow-hidden p-10 rounded-xl bg-surface-container-lowest shadow-[0_40px_40px_rgba(0,0,0,0.04)]">
<div class="absolute top-0 right-0 w-64 h-64 bg-primary-container/20 rounded-full -mr-20 -mt-20 blur-3xl"></div>
<div class="relative z-10">
<span class="font-label text-[0.75rem] font-bold tracking-widest uppercase text-on-primary-container/60 mb-2 block">Totale Entrate Mensili</span>
<div class="flex items-baseline gap-2">
<span class="text-[3.5rem] font-extrabold tracking-tighter text-on-surface">€2.850</span>
<span class="text-[1.5rem] font-semibold text-on-surface-variant">,00</span>
</div>
</div>
</div>
</section>
<!-- Dynamic Entry List (Organic Bento/Cards) -->
<section class="space-y-4">
<!-- Item: Stipendio -->
<div class="bg-surface-container-low p-8 rounded-lg flex flex-col md:flex-row md:items-center justify-between gap-6 transition-all hover:bg-surface-container-high group">
<div class="flex items-center gap-5">
<div class="w-14 h-14 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-sm text-primary">
<span class="material-symbols-outlined text-3xl" data-icon="payments">payments</span>
</div>
<div>
<h3 class="title-md font-semibold text-on-surface">Stipendio</h3>
<p class="text-on-surface-variant text-sm">Entrata principale fissa</p>
</div>
</div>
<div class="flex items-center gap-3">
<div class="relative">
<span class="absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant font-medium">€</span>
<input class="w-32 pl-8 pr-4 py-3 bg-surface-container-highest border-none rounded-md focus:ring-1 focus:ring-primary/20 text-right font-semibold text-on-surface transition-all" type="text" value="2.400"/>
</div>
<div class="px-4 py-3 bg-primary-container/30 text-primary font-bold text-[10px] tracking-widest uppercase rounded-md">Mensile</div>
</div>
</div>
<!-- Item: Bonus/Extra -->
<div class="bg-surface-container-low p-8 rounded-lg flex flex-col md:flex-row md:items-center justify-between gap-6 transition-all hover:bg-surface-container-high group">
<div class="flex items-center gap-5">
<div class="w-14 h-14 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-sm text-primary">
<span class="material-symbols-outlined text-3xl" data-icon="redeem">redeem</span>
</div>
<div>
<h3 class="title-md font-semibold text-on-surface">Bonus</h3>
<p class="text-on-surface-variant text-sm">Premi o incentivi</p>
</div>
</div>
<div class="flex items-center gap-3">
<div class="relative">
<span class="absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant font-medium">€</span>
<input class="w-32 pl-8 pr-4 py-3 bg-surface-container-highest border-none rounded-md focus:ring-1 focus:ring-primary/20 text-right font-semibold text-on-surface transition-all" placeholder="0" type="text"/>
</div>
<div class="px-4 py-3 bg-surface-container-highest text-on-surface-variant font-bold text-[10px] tracking-widest uppercase rounded-md">Mensile</div>
</div>
</div>
<!-- Item: Altro -->
<div class="bg-surface-container-low p-8 rounded-lg flex flex-col md:flex-row md:items-center justify-between gap-6 transition-all hover:bg-surface-container-high group border-2 border-dashed border-outline-variant/20">
<div class="flex items-center gap-5">
<div class="w-14 h-14 rounded-full bg-surface-container-lowest/50 flex items-center justify-center text-outline">
<span class="material-symbols-outlined text-3xl" data-icon="add">add</span>
</div>
<div>
<h3 class="title-md font-semibold text-on-surface">Altro</h3>
<p class="text-on-surface-variant text-sm">Aggiungi altre entrate</p>
</div>
</div>
<div class="flex items-center gap-3">
<div class="relative">
<span class="absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant font-medium">€</span>
<input class="w-32 pl-8 pr-4 py-3 bg-surface-container-highest border-none rounded-md focus:ring-1 focus:ring-primary/20 text-right font-semibold text-on-surface transition-all" type="text" value="450"/>
</div>
<div class="px-4 py-3 bg-primary-container/30 text-primary font-bold text-[10px] tracking-widest uppercase rounded-md">Mensile</div>
</div>
</div>
</section>
<!-- Growth Bloom Decorative Element -->
<div class="mt-16 flex flex-col items-center">
<div class="w-24 h-24 relative">
<svg class="w-full h-full fill-primary-container opacity-40 animate-pulse" viewbox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
