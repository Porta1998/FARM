</svg>
<div class="absolute inset-0 flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-4xl" data-icon="eco" style="font-variation-settings: 'FILL' 1;">eco</span>
</div>
</div>
<p class="text-on-surface-variant text-[0.75rem] font-bold tracking-widest uppercase mt-4">Stai crescendo bene</p>
</div>
</main>
<!-- Navigation Shell (Bottom) -->
<nav class="fixed bottom-0 left-0 w-full flex justify-between items-center px-10 pb-10 pt-6 bg-[#faf9f6]/70 dark:bg-[#1a1c18]/70 backdrop-blur-3xl shadow-[0_-20px_40px_rgba(0,0,0,0.03)] z-50 rounded-t-[3rem]">
<!-- Inactive Action -->
<button class="flex flex-col items-center justify-center text-[#2f3430] dark:text-[#edeeea] bg-[#edeeea] dark:bg-[#2f3430] rounded-full px-8 py-3 hover:brightness-110 transition-all active:scale-[0.98] duration-200">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-xl" data-icon="chevron_left">chevron_left</span>
<span class="font-manrope text-[12px] font-bold tracking-widest uppercase">Indietro</span>
</div>
</button>
<!-- Active Action -->
<button class="flex flex-col items-center justify-center bg-[#456646] text-white rounded-full px-8 py-3 hover:brightness-110 transition-all active:scale-[0.98] duration-200">
<div class="flex items-center gap-2">
<span class="font-manrope text-[12px] font-bold tracking-widest uppercase">Continua</span>
<span class="material-symbols-outlined text-xl" data-icon="chevron_right">chevron_right</span>
</div>
</button>
</nav>
