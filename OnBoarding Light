<!DOCTYPE html>

<html class="light" lang="it"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "on-surface": "#2f3430",
              "outline-variant": "#afb3ae",
              "surface-container-lowest": "#ffffff",
              "surface-container-low": "#f4f4f0",
              "error-dim": "#5c1202",
              "inverse-surface": "#0d0f0d",
              "surface": "#faf9f6",
              "surface-container-highest": "#e0e4de",
              "on-tertiary-container": "#585e4e",
              "surface-dim": "#d6dbd5",
              "primary-fixed-dim": "#b8deb6",
              "background": "#faf9f6",
              "tertiary-fixed": "#f1f6e1",
              "on-secondary-fixed": "#394237",
              "on-tertiary-fixed-variant": "#636858",
              "on-primary": "#e4ffe0",
              "surface-tint": "#456646",
              "secondary-fixed": "#dbe5d7",
              "tertiary-dim": "#505545",
              "on-secondary": "#f2fced",
              "primary-dim": "#395a3b",
              "primary-fixed": "#c6edc4",
              "error": "#9e422c",
              "on-surface-variant": "#5c605c",
              "surface-container": "#edeeea",
              "secondary-container": "#dbe5d7",
              "on-secondary-container": "#4b5449",
              "on-primary-container": "#38593a",
              "on-error": "#fff7f6",
              "secondary": "#586256",
              "error-container": "#fe8b70",
              "on-primary-fixed": "#264629",
              "tertiary-fixed-dim": "#e3e8d3",
              "inverse-on-surface": "#9d9d9a",
              "outline": "#777c77",
              "secondary-fixed-dim": "#cdd7c9",
              "on-tertiary": "#f6fbe6",
              "on-error-container": "#742410",
              "surface-variant": "#e0e4de",
              "tertiary-container": "#f1f6e1",
              "on-secondary-fixed-variant": "#555e53",
              "on-primary-fixed-variant": "#426344",
              "on-tertiary-fixed": "#464c3c",
              "primary": "#456646",
              "inverse-primary": "#d7fed4",
              "surface-container-high": "#e6e9e4",
              "surface-bright": "#faf9f6",
              "primary-container": "#c6edc4",
              "on-background": "#2f3430",
              "secondary-dim": "#4c564b",
              "tertiary": "#5c6151"
            },
            fontFamily: {
              "headline": ["Manrope"],
              "body": ["Manrope"],
              "label": ["Manrope"]
            },
            borderRadius: {"DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px"},
          },
        },
      }
    </script>
<style>
        body { font-family: 'Manrope', sans-serif; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type=number] {
            -moz-appearance: textfield;
        }
        .text-glow {
            text-shadow: 0 0 40px rgba(69, 102, 70, 0.08);
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-surface text-on-surface min-h-screen flex flex-col items-center justify-between selection:bg-primary-container selection:text-on-primary-container">
<!-- Top Navigation Anchor (Shared Component Suppression Applied: Task-Focused Flow) -->
<header class="w-full flex justify-center pt-16 pb-8">
<div class="flex items-center gap-2">
<span class="text-primary font-extrabold tracking-tighter text-2xl">FARM</span>
</div>
</header>
<!-- Main Content Canvas -->
<main class="w-full max-w-2xl px-8 flex flex-col items-center flex-grow justify-center text-center">
<!-- Animated Editorial Moment -->
<div class="space-y-4 mb-12">
<h1 class="text-on-surface text-4xl md:text-5xl font-extrabold tracking-tight">
                Quanto hai oggi?
            </h1>
<p class="text-on-surface-variant text-md md:text-lg max-w-md mx-auto font-medium leading-relaxed">
                Questo è l'unico dato che ci serve per iniziare. Potrai aggiungere il resto con calma.
            </p>
</div>
<!-- Giant Numeric Input Cluster -->
<div class="relative group w-full flex flex-col items-center">
<div class="flex items-baseline justify-center w-full transition-all duration-300">
<span class="text-primary-dim text-4xl md:text-6xl font-light mr-4 select-none">€</span>
<input autofocus="" class="bg-transparent border-none focus:ring-0 text-7xl md:text-[8rem] font-extrabold text-on-surface p-0 w-auto min-w-[1ch] text-glow placeholder:text-surface-container-highest transition-all text-center" placeholder="0" type="number"/>
</div>
<!-- Visual Indicator (Growth Bloom style concept) -->
<div class="w-24 h-1 bg-primary/10 rounded-full mt-4 overflow-hidden">
<div class="w-1/3 h-full bg-primary rounded-full"></div>
</div>
</div>
</main>
<!-- Call to Action Section (Apple-inspired Style) -->
<footer class="w-full max-w-md px-8 pb-16 pt-8 flex flex-col items-center gap-6">
<button class="w-full bg-primary text-on-primary py-5 rounded-full text-lg font-bold shadow-[0_20px_40px_rgba(69,102,70,0.15)] active:scale-95 transition-all duration-200 hover:opacity-90">
            Inizia a esplorare
        </button>
<div class="flex items-center gap-6">
<button class="text-on-surface-variant text-sm font-semibold tracking-wide uppercase hover:text-primary transition-colors">
                Recupera backup
            </button>
<div class="w-1 h-1 bg-outline-variant rounded-full"></div>
<button class="text-on-surface-variant text-sm font-semibold tracking-wide uppercase hover:text-primary transition-colors">
                Privacy
            </button>
</div>
</footer>
<!-- Decorative Background Elements (Organic Blob/Greenhouse Aesthetics) -->
<div class="fixed top-[-10%] right-[-10%] w-[500px] h-[500px] bg-primary/5 rounded-full blur-[100px] -z-10 pointer-events-none"></div>
<div class="fixed bottom-[-5%] left-[-5%] w-[400px] h-[400px] bg-primary-container/10 rounded-full blur-[80px] -z-10 pointer-events-none"></div>
</body></html>
